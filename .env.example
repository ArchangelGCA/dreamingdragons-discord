# ─── Discord ─────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Application (client) ID
DISCORD_CLIENT_ID=your_client_id_here
# Optional: a single guild ID for INSTANT slash-command updates (dev/single server).
# Leave empty to deploy commands GLOBALLY (can take up to ~1 hour to appear).
DISCORD_GUILD_ID=

# ─── PocketBase ──────────────────────────────────────────────────────────
# The superuser is created/updated automatically on first start from these.
# Password MUST be at least 8 characters.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change_me_min_8_chars
# Only needed when running the bot/web OUTSIDE Docker. Inside docker compose the
# services talk to http://pocketbase:8090 automatically (this value is ignored there).
POCKETBASE_URL=http://127.0.0.1:8090
# Host port to expose the PocketBase dashboard (http://localhost:8090/_/).
POCKETBASE_PORT=8090

# ─── Admin dashboard (web) ───────────────────────────────────────────────
# Host port for the SvelteKit admin dashboard.
WEB_PORT=3000
# MUST match the URL you actually open the dashboard from, or form submits fail.
# Examples: http://localhost:3000  or  https://admin.yourdomain.com
ORIGIN=http://localhost:3000
# Public base URL of the site (usually the same public origin as ORIGIN,
# e.g. https://bot.yourdomain.com when exposed via the tunnel). Set it to enable:
#   • the "View stats online" link button on the bot's /level command
# Leave empty if you don't expose the public site (the site itself works without it).
PUBLIC_URL=

# ─── Internal bot API bridge ─────────────────────────────────────────────
# Lets the dashboard resolve Discord names/avatars and perform Discord actions
# (post reaction-role messages, sync/recover XP, re-assign reward roles) by
# calling the bot server-side. The bot exposes this API ONLY on the internal
# Docker network (http://bot:8787) — it is never published to a host port.
#
# REQUIRED for the "live" dashboard features. If left blank the bot disables the
# API and the dashboard degrades gracefully (raw IDs, DB-only edits, offline banner).
# Both the bot and web MUST share the exact same value.
# Generate a random 32+ char secret, e.g.:  openssl rand -hex 32
INTERNAL_API_SECRET=
# Port the bot's internal API listens on (internal network only; no host mapping).
BOT_API_PORT=8787

# ─── Cloudflare Tunnel (optional) ────────────────────────────────────────
# Only used with:  docker compose --profile tunnel up -d
# Create a tunnel token in the Cloudflare Zero Trust dashboard.
TUNNEL_TOKEN=

# ─── Automatic updates / continuous deployment (optional) ────────────────
# The `updater` service watches your git remote and, when you push new commits,
# pulls them and rebuilds the stack IN PLACE (data volumes are preserved — it
# never wipes PocketBase). No GitHub Actions required.
#
# ⚠ Security: the updater controls the host's Docker (root-equivalent). Only
# turn it on for a deployment you trust. It's OFF by default.
#
# Flip this to true (then `docker compose up -d updater`) to enable auto-update.
AUTO_UPDATE=false
# How often to check the remote for new commits, in seconds (default 300 = 5 min).
AUTO_UPDATE_INTERVAL=300
# Git branch to track / deploy from.
AUTO_UPDATE_BRANCH=master
# Git remote name to pull from (almost always "origin").
AUTO_UPDATE_REMOTE=origin
# PRIVATE repos only: a GitHub token (PAT/fine-grained, "Contents: read") so the
# updater can fetch. Leave blank for public repos.
GIT_PULL_TOKEN=

# The compose project name. Normally auto-detected — leave blank. Only set it to
# force a specific name (must match your existing stack, or a new empty pb_data
# volume would be created). Check yours with:  docker volume ls | grep pb_data
COMPOSE_PROJECT_NAME=
# Active compose profiles. Set to "tunnel" if you run the Cloudflare Tunnel, so
# the updater keeps managing it too. Comma-separate multiple (e.g. "tunnel").
COMPOSE_PROFILES=
